# Copy to .env and adjust. Every variable is optional; defaults work for a first try.

# --- versions (pin both to the same release, e.g. 1.0.2) ---
MOVARY_BACKEND_TAG=latest
MOVARY_FRONTEND_TAG=latest

# --- ports ---
MOVARY_FRONTEND_PORT=80
MOVARY_BACKEND_PORT=8000

# --- postgres ---
POSTGRES_USER=movary
POSTGRES_PASSWORD=movary
POSTGRES_DB=movary

# --- security: MUST change before exposing to the internet ---
MOVARY_SECRET_KEY=change-me-in-production
